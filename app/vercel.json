{
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "{app.py,synthetic-patient-data.md,snapshot/**}"
    },
    "api/voice.py": {
      "maxDuration": 120,
      "includeFiles": "voice/**"
    }
  },
  "rewrites": [
    {
      "source": "/voice/(.*)",
      "destination": "/api/voice"
    },
    {
      "source": "/voice-panel.js",
      "destination": "/static/voice-panel.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/static/index.html"
    },
    {
      "source": "/screen",
      "destination": "/static/screen.html"
    },
    {
      "source": "/demo",
      "destination": "/static/demo.html"
    }
  ]
}
